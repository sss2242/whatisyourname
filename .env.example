# Operator 1 -- API Keys & Identities
# Copy this file to .env and fill in ALL values before running.
# All registrations are FREE. The pipeline will refuse to start
# if any key is missing.
#
# On Kaggle, use Kaggle Secrets instead (these are ignored on Kaggle).

# ---------------------------------------------------------------------------
# LLM Providers (BOTH required -- used for report generation, entity
# discovery, and sentiment analysis)
# ---------------------------------------------------------------------------

# Google Gemini -- https://aistudio.google.com/app/apikey
# RECOMMENDED: Gemini free tier gives 1500 req/day -- enough for 300+ runs.
# Multi-key: comma-separate or use numbered variants (GEMINI_API_KEY_1, _2, etc.)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude -- https://console.anthropic.com/
# NOTE: Claude free tier gives $5 credit. With Sonnet ($3/$15 per MTok) that
# covers ~15 runs. With Haiku ($0.25/$1.25 per MTok) that covers ~160 runs.
# Opus ($15/$75 per MTok) exhausts in ~3 runs -- avoid for free-tier keys.
# Multi-key: comma-separate or use numbered variants (ANTHROPIC_API_KEY_1, _2, etc.)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter -- https://openrouter.ai/
# 200+ models available, including free-tier options.
# Supports Google, Anthropic, Meta, Mistral, DeepSeek models via a single key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Which LLM to use by default: "gemini", "claude", or "openrouter" (auto-detects if empty)
# On exhaustion, automatically falls back to the other provider.
# LLM_PROVIDER=gemini

# ---------------------------------------------------------------------------
# US Market -- SEC EDGAR (email identity required by SEC regulation)
# ---------------------------------------------------------------------------
EDGAR_IDENTITY=your.name@example.com

# ---------------------------------------------------------------------------
# UK Market -- Companies House
# Register at https://developer.company-information.service.gov.uk/
# ---------------------------------------------------------------------------
COMPANIES_HOUSE_API_KEY=your_companies_house_key_here

# ---------------------------------------------------------------------------
# Japan Market -- J-Quants (free email registration)
# Register at https://jpx-jquants.com/login
# ---------------------------------------------------------------------------
JQUANTS_API_KEY=your_jquants_api_key_here

# ---------------------------------------------------------------------------
# South Korea Market -- DART
# Register at https://opendart.fss.or.kr/
# ---------------------------------------------------------------------------
DART_API_KEY=your_dart_api_key_here

# ---------------------------------------------------------------------------
# Macro Data Sources
# ---------------------------------------------------------------------------

# US FRED -- https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key_here

# Mexico Banxico -- https://www.banxico.org.mx/SieAPIRest/
BANXICO_TOKEN=your_banxico_token_here

# ---------------------------------------------------------------------------
# Identifier Resolution
# ---------------------------------------------------------------------------

# OpenFIGI -- https://www.openfigi.com/api
openfigi_key=your_openfigi_key_here

# ---------------------------------------------------------------------------
# Supported PIT Markets
# ---------------------------------------------------------------------------
# US:     SEC EDGAR    -- NYSE/NASDAQ ($50T)    -- email identity required
# EU:     ESEF/XBRL   -- Pan-EU ($8-9T)        -- no key needed
# UK:     Companies House -- LSE ($3.18T)       -- key required
# Japan:  J-Quants     -- TSE ($6.5T)           -- key required
# Korea:  DART         -- KOSPI/KOSDAQ ($2.5T)  -- key required
# Taiwan: MOPS         -- TWSE/TPEX (~$1.2T)    -- no key needed
# Brazil: CVM          -- B3 ($2.2T)            -- no key needed
# Chile:  CMF          -- Santiago ($0.4T)       -- no key needed
#
# Total coverage: $91+ trillion in market cap across 10 countries.
